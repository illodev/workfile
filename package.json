{
  "name": "@illodev/workfile",
  "version": "0.1.1",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "description": "Repository-native protocol and local MCP server for Work, Docs, History and durable project Memory.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/illodev/workfile.git"
  },
  "homepage": "https://github.com/illodev/workfile#readme",
  "bugs": {
    "url": "https://github.com/illodev/workfile/issues"
  },
  "bin": {
    "workfile": "dist/bin/workfile.js",
    "workfile-mcp": "dist/bin/workfile-mcp.js"
  },
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./core": {
      "types": "./dist/src/core/index.d.ts",
      "import": "./dist/src/core/index.js"
    },
    "./cards": {
      "types": "./dist/src/modules/cards/index.d.ts",
      "import": "./dist/src/modules/cards/index.js"
    },
    "./server": {
      "types": "./dist/src/server/http.d.ts",
      "import": "./dist/src/server/http.js"
    },
    "./docs": {
      "types": "./dist/src/modules/docs/index.d.ts",
      "import": "./dist/src/modules/docs/index.js"
    },
    "./changelog": {
      "types": "./dist/src/modules/changelog/index.d.ts",
      "import": "./dist/src/modules/changelog/index.js"
    },
    "./memory": {
      "types": "./dist/src/modules/memory/index.d.ts",
      "import": "./dist/src/modules/memory/index.js"
    },
    "./records": {
      "types": "./dist/src/modules/records/public.d.ts",
      "import": "./dist/src/modules/records/public.js"
    },
    "./agents": {
      "types": "./dist/src/modules/agents/index.d.ts",
      "import": "./dist/src/modules/agents/index.js"
    },
    "./ci": {
      "types": "./dist/src/modules/ci/index.d.ts",
      "import": "./dist/src/modules/ci/index.js"
    },
    "./init": {
      "types": "./dist/src/modules/init/index.d.ts",
      "import": "./dist/src/modules/init/index.js"
    },
    "./migration": {
      "types": "./dist/src/modules/migration/index.d.ts",
      "import": "./dist/src/modules/migration/index.js"
    },
    "./claude": {
      "types": "./dist/src/modules/claude/index.d.ts",
      "import": "./dist/src/modules/claude/index.js"
    },
    "./mcp": {
      "types": "./dist/src/modules/mcp/index.d.ts",
      "import": "./dist/src/modules/mcp/index.js"
    },
    "./search": {
      "types": "./dist/src/modules/search/index.d.ts",
      "import": "./dist/src/modules/search/index.js"
    },
    "./integrations": {
      "types": "./dist/src/modules/integrations/index.d.ts",
      "import": "./dist/src/modules/integrations/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build:core": "tsc -p tsconfig.json && node ./scripts/prepare-bin.mjs",
    "typecheck:api": "tsc -p test/types/tsconfig.json",
    "strict": "node ./scripts/strict-ratchet.mjs",
    "test": "pnpm run build:core && pnpm run typecheck:api && node --test test/*.test.mjs",
    "doctor": "node ./dist/bin/workfile.js doctor",
    "schema": "node ./dist/bin/workfile.js schema",
    "serve": "node ./dist/bin/workfile.js ui",
    "build:ui": "vite build --config vite.config.mjs",
    "typecheck:ui": "tsc -p ui/tsconfig.json",
    "demo:data": "pnpm run build:core && node ./scripts/build-demo-data.mjs",
    "build:demo": "pnpm run demo:data && vite build --config vite.config.mjs --mode demo",
    "build": "pnpm run clean && pnpm run build:core && pnpm run typecheck:ui && pnpm run build:ui",
    "prepack": "pnpm run build",
    "check": "pnpm run build && pnpm run build:plugin && pnpm run typecheck:api && pnpm run strict && node --test test/*.test.mjs",
    "smoke:package": "node ./test/package-smoke.mjs",
    "bench": "node ./scripts/bench.mjs",
    "screenshots": "pnpm run build && node ./scripts/screenshots.mjs",
    "build:plugin": "node ./scripts/build-plugin.mjs",
    "check:release": "pnpm run check && pnpm audit --audit-level=high && pnpm run smoke:package",
    "project": "workfile ui",
    "project:doctor": "workfile doctor",
    "project:agents": "workfile agents sync",
    "project:mcp": "workfile mcp"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "project.config.example.mjs"
  ],
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "lucide-react": "^1.27.0",
    "playwright": "^1.62.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  },
  "dependencies": {
    "@types/node": "26.1.2"
  },
  "keywords": [
    "project-management",
    "mcp",
    "model-context-protocol",
    "agents",
    "markdown",
    "backlog",
    "documentation",
    "changelog"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
